---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { AppToaster } from "../components/app-toaster";
import AuthGuard from "../components/AuthGuard.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { isRegistrationRestrictedPath } from "../lib/registration-only";

interface Props {
  title?: string;
  heading?: string;
  backHref?: string;
  requireAuth?: boolean;
  allowMaestro?: boolean;
  enableClientRouting?: boolean;
  deferChrome?: boolean;
}

const {
  title = "Bebras",
  heading,
  backHref,
  requireAuth = false,
  allowMaestro = false,
  enableClientRouting = true,
  deferChrome = false,
} = Astro.props;
const registrationRestricted = isRegistrationRestrictedPath(Astro.url.pathname);

const pageOut = {
  name: "bebras-page-out",
  duration: "140ms",
  easing: "cubic-bezier(0.4, 0, 1, 1)",
  fillMode: "both",
};
const pageIn = {
  name: "bebras-page-in",
  duration: "300ms",
  delay: "60ms",
  easing: "cubic-bezier(0.22, 1, 0.36, 1)",
  fillMode: "both",
};
const pageFade = {
  forwards: { old: pageOut, new: pageIn },
  backwards: { old: pageOut, new: pageIn },
};
---

<!doctype html>
<html
  lang="es"
  transition:name="app-root"
  transition:animate="none"
  data-registration-blocked={registrationRestricted ? "" : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/castor.png" />
    <title>{title}</title>
    {enableClientRouting && <ClientRouter />}
  </head>
  <body>
    {
      (requireAuth || registrationRestricted) && (
        <AuthGuard
          allowMaestro={allowMaestro}
          registrationRestricted={registrationRestricted}
        />
      )
    }
    <div class="flex min-h-screen flex-col">
      <SiteHeader heading={heading} backHref={backHref} hidden={deferChrome} />
      <div
        class="min-h-dvh flex-1"
        data-page-content
        transition:name="app-content"
        transition:animate={pageFade}
      >
        <slot />
      </div>
      <SiteFooter hidden={deferChrome} />
    </div>
    <AppToaster client:load transition:persist="app-toaster" />
  </body>
</html>

<script>
  const bar = document.createElement("div");
  bar.setAttribute("aria-hidden", "true");
  bar.className = "bebras-nav-bar";
  document.documentElement.append(bar);

  document.addEventListener("astro:before-preparation", () => {
    document.documentElement.dataset.navigating = "";
    bar.style.transition = "none";
    bar.style.width = "0";
    void bar.offsetWidth;
    bar.style.transition = "width 8s cubic-bezier(0.1, 0.8, 0.2, 1)";
    bar.style.width = "85%";
  });

  const finish = () => {
    if (!("navigating" in document.documentElement.dataset)) return;
    delete document.documentElement.dataset.navigating;
    bar.style.transition = "width 150ms ease-out";
    bar.style.width = "100%";
    window.setTimeout(() => {
      if (!("navigating" in document.documentElement.dataset)) {
        bar.style.transition = "none";
        bar.style.width = "0";
      }
    }, 250);
  };
  document.addEventListener("astro:page-load", finish);
  document.addEventListener("astro:after-swap", finish);
</script>

<style is:global>
  html[data-registration-blocked] [data-page-content] {
    display: none;
  }
  .bebras-nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    height: 3px;
    width: 0;
    background: var(--primary);
    pointer-events: none;
  }
  html[data-navigating] {
    cursor: progress;
  }
  html[data-navigating] [data-page-content] {
    opacity: 0.6;
    transition: opacity 150ms ease-out;
  }
</style>
