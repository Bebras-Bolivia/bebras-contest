---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { AppToaster } from "../components/app-toaster";
import AuthGuard from "../components/AuthGuard.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { TrialViewBanner } from "../components/trial-view-banner";
import SiteFooter from "../components/SiteFooter.astro";
import { isRegistrationRestrictedPath } from "../lib/registration-only";

interface Props {
  title?: string;
  heading?: string;
  backHref?: string;
  backInPage?: boolean;
  requireAuth?: boolean;
  allowMaestro?: boolean;
  enableClientRouting?: boolean;
  deferChrome?: boolean;
}

const {
  title = "Bebras",
  heading,
  backHref,
  backInPage = false,
  requireAuth = false,
  allowMaestro = false,
  enableClientRouting = true,
  deferChrome = false,
} = Astro.props;
const registrationRestricted = isRegistrationRestrictedPath(Astro.url.pathname);
const practiceBack =
  Astro.url.pathname === "/practica/categoria" ||
  Astro.url.pathname === "/practica/tarea";

const pageOut = {
  name: "bebras-page-out",
  duration: "140ms",
  easing: "cubic-bezier(0.4, 0, 1, 1)",
  fillMode: "both",
};
const pageIn = {
  name: "bebras-page-in",
  duration: "300ms",
  delay: "60ms",
  easing: "cubic-bezier(0.22, 1, 0.36, 1)",
  fillMode: "both",
};
const pageFade = {
  forwards: { old: pageOut, new: pageIn },
  backwards: { old: pageOut, new: pageIn },
};
---

<!doctype html>
<html
  lang="es"
  transition:name="app-root"
  transition:animate="none"
  data-registration-blocked={registrationRestricted ? "" : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/castor.png" />
    <title>{title}</title>
    {enableClientRouting && <ClientRouter />}
  </head>
  <body>
    {
      (requireAuth || registrationRestricted) && (
        <AuthGuard
          allowMaestro={allowMaestro}
          registrationRestricted={registrationRestricted}
        />
      )
    }
    <div class="flex min-h-screen flex-col">
      <SiteHeader heading={heading} hidden={deferChrome} />
      <TrialViewBanner client:only="react" />
      <div
        class="flex-1"
        data-page-content
        transition:name="app-content"
        transition:animate={pageFade}
      >
        <slot />
        {
          backHref && !backInPage && (
            <div class="mx-auto flex w-full max-w-6xl justify-end px-4 pb-10 sm:px-6 lg:px-8">
              <a
                href={backHref}
                data-back-link
                data-practice-back={practiceBack ? "" : undefined}
                data-slot="button"
                data-variant="outline"
                class="inline-flex h-10 items-center gap-1.5 border bg-background px-4 pl-3 text-sm font-semibold transition-all outline-none hover:bg-accent hover:text-background focus-visible:ring-[3px] focus-visible:ring-ring/50"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="size-4 shrink-0"
                >
                  <path d="m15 18-6-6 6-6" />
                </svg>
                Volver
              </a>
            </div>
          )
        }
      </div>
      <SiteFooter hidden={deferChrome} />
    </div>
    <AppToaster client:load transition:persist="app-toaster" />
  </body>
</html>

<style is:global>
  html[data-registration-blocked] [data-page-content] {
    display: none;
  }
</style>
