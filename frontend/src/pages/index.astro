---
import Layout from "../layouts/Layout.astro";
import { LiveContests } from "../components/live-contests";
import { DepartmentBeavers } from "../components/department-beavers";
import { InfoSiteBanner } from "../components/info-site-banner";
import { PublicRanking } from "../components/public-ranking";
import { REGISTRATION_ONLY } from "../lib/registration-only";

const title = "Desafío Bebras Bolivia";

const steps = [
  {
    image: "bandera",
    title: "Te inscribes",
    text: "Tu maestro te da el código de tu grupo. Con él te inscribes y recibes tu código personal.",
  },
  {
    image: "laptop",
    title: "Resuelves el desafío",
    text: "El día de la prueba entras con tu código personal y tienes unos minutos para resolver preguntas de lógica.",
  },
  {
    image: "idea",
    title: "Ves tus resultados",
    text: "Cuando cierra el desafío se publican tus puntos, tu lugar en tu categoría y las soluciones.",
  },
];
---

<Layout title={title}>
  <div
    class="mx-auto flex w-full max-w-6xl flex-col gap-16 px-4 py-12 sm:px-6 lg:px-8"
  >
    <header
      class="grid items-center gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:gap-12"
    >
      <div class="flex flex-col items-start gap-5">
        <span
          class="home-in text-sm font-semibold tracking-wide text-primary uppercase"
        >
          Pensamiento computacional para todos
        </span>
        <h1
          style="--delay: 80ms"
          class="home-in font-heading text-4xl font-semibold tracking-tight sm:text-5xl"
        >
          Desafío Bebras Bolivia
        </h1>
        <p
          style="--delay: 160ms"
          class="home-in max-w-xl text-base leading-7 text-muted-foreground sm:text-lg"
        >
          Problemas cortos y divertidos para pensar como informático. No
          necesitas saber programar: solo ganas de resolverlos.
        </p>
        <div
          style="--delay: 240ms"
          class="home-in flex w-full flex-col gap-3 sm:w-auto sm:flex-row"
        >
          {
            !REGISTRATION_ONLY && (
              <a
                href="/entrar"
                class="inline-flex h-12 items-center justify-center gap-2 bg-primary px-6 text-base font-semibold text-primary-foreground shadow-[var(--shadow-hard)] press-hard hover:opacity-90"
              >
                Entrar con mi código
              </a>
            )
          }
          <a
            href="/login"
            class="inline-flex h-12 items-center justify-center gap-2 border-2 border-foreground bg-background px-6 text-base font-semibold shadow-[var(--shadow-hard)] press-hard hover:bg-muted"
          >
            Soy maestro
          </a>
        </div>
        {
          !REGISTRATION_ONLY && (
            <a
              href="/practica"
              style="--delay: 320ms"
              class="home-in text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground"
            >
              ¿Solo quieres practicar?
            </a>
          )
        }
      </div>
      <div style="--delay: 120ms" class="home-in">
        <DepartmentBeavers client:load />
      </div>
    </header>

    {
      !REGISTRATION_ONLY && (
        <section>
          <LiveContests client:only="react" />
        </section>
      )
    }

    {!REGISTRATION_ONLY && <PublicRanking client:only="react" />}

    <section class="flex flex-col gap-6">
      <h2
        data-reveal
        class="font-heading text-2xl font-semibold tracking-tight"
      >
        ¿Cómo funciona?
      </h2>
      <ol class="grid gap-4 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li
              data-reveal
              style={`--delay: ${index * 110}ms`}
              class="group flex flex-col gap-2 border-2 border-border/20 px-5 py-5 hover:border-primary/60"
            >
              <div class="flex items-end justify-between gap-3">
                <span class="font-heading text-3xl font-semibold text-primary">
                  {index + 1}
                </span>
                <img
                  src={`/castores/${step.image}.webp`}
                  alt=""
                  loading="lazy"
                  class="h-20 w-auto transition-transform duration-300 group-hover:-translate-y-1 group-hover:-rotate-6"
                />
              </div>
              <h3 class="text-base font-semibold">{step.title}</h3>
              <p class="text-sm leading-6 text-muted-foreground">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <InfoSiteBanner client:only="react" />

    <section
      data-reveal
      class="grid gap-6 border-t pt-10 md:grid-cols-2 md:gap-12"
    >
      {
        !REGISTRATION_ONLY && (
          <div class="flex flex-col items-start gap-3">
            <h2 class="font-heading text-xl font-semibold">Practica</h2>
            <p class="text-sm leading-6 text-muted-foreground">
              Resuelve los desafíos de años anteriores cuando quieras, a tu
              ritmo y viendo la solución de cada uno.
            </p>
            <a
              href="/practica"
              class="text-sm font-semibold text-primary underline underline-offset-4"
            >
              Ir a practicar
            </a>
          </div>
        )
      }
      <div class="flex flex-col items-start gap-3">
        <h2 class="font-heading text-xl font-semibold">Maestros</h2>
        <p class="text-sm leading-6 text-muted-foreground">
          {
            REGISTRATION_ONLY
              ? "Registren su cuenta y completen sus datos y documentos para la revisión del administrador."
              : "Creen su cuenta, inscriban a sus estudiantes en un grupo por categoría y sigan sus resultados. También pueden armarles prácticas."
          }
        </p>
        <a
          href="/login"
          class="text-sm font-semibold text-primary underline underline-offset-4"
        >
          Iniciar sesión o registrarse
        </a>
      </div>
    </section>
  </div>
</Layout>

<script>
  function revealOnScroll() {
    const pending = document.querySelectorAll("[data-reveal]:not(.is-visible)");
    if (pending.length === 0) return;
    if (!("IntersectionObserver" in window)) {
      pending.forEach((element) => element.classList.add("is-visible"));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );
    pending.forEach((element) => observer.observe(element));
    document.addEventListener(
      "astro:before-swap",
      () => observer.disconnect(),
      {
        once: true,
      },
    );
  }

  document.addEventListener("astro:page-load", revealOnScroll);
</script>
