---
import Layout from "../../layouts/Layout.astro";
import { ContestEditor } from "../../components/contest-editor";

const title = "Desafío";
---

<Layout title={title} heading={title} backHref="/desafios" requireAuth>
  <main class="mx-auto flex w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex w-full flex-col gap-6">
      <ContestEditor client:only="react" />
    </div>
  </main>
</Layout>
