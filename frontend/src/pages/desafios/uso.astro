---
import Layout from "../../layouts/Layout.astro";
import { ContestUsagePage } from "../../components/contest-usage";

const title = "Uso y opiniones";
---

<Layout title={title} heading={title} backHref="/desafios" requireAuth>
  <main class="mx-auto flex w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex w-full flex-col gap-6">
      <ContestUsagePage client:only="react" />
    </div>
  </main>
</Layout>
