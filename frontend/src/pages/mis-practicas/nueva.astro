---
import Layout from "../../layouts/Layout.astro";
import { PracticeEditor } from "../../components/practice-editor";

const title = "Nueva práctica";
---

<Layout
  title={title}
  heading={title}
  backHref="/mis-practicas"
  backInPage
  requireAuth
  allowMaestro
>
  <main class="mx-auto flex w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex w-full flex-col gap-6">
      <PracticeEditor client:only="react" />
    </div>
  </main>
</Layout>
