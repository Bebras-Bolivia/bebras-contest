---
import Layout from "../../layouts/Layout.astro";
import { PaperEntry } from "../../components/paper-entry";
---

<Layout
  title="Respuestas en papel"
  heading="Respuestas en papel"
  backHref="/grupos"
  requireAuth
  allowMaestro
  enableClientRouting={false}
>
  <main class="mx-auto flex w-full max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <PaperEntry client:only="react" />
  </main>
</Layout>
