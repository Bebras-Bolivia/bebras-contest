---
import Layout from "../layouts/Layout.astro";
import { JoinForm } from "../components/join-form";
import { PracticeCategories } from "../components/practice-categories";

const title = "Entrar al desafío";
---

<Layout title={title} heading="Entrar al desafío" backHref="/">
  <main
    class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-4 py-16 sm:py-20"
  >
    <section>
      <JoinForm client:load />
    </section>

    <section class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <div class="h-px flex-1 bg-border"></div>
        <span
          class="text-xs font-medium uppercase tracking-wide text-muted-foreground"
        >
          Mientras tanto
        </span>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      <div class="flex flex-col gap-2 text-center">
        <h2 class="text-xl font-semibold">Desafíos de práctica</h2>
        <p class="text-sm leading-6 text-muted-foreground">
          No necesitas código ni cuenta. Elige tu categoría según tu edad y
          empieza a practicar.
        </p>
      </div>

      <PracticeCategories client:only="react" />
    </section>
  </main>
</Layout>
