---
interface Props {
  hidden?: boolean;
}

const { hidden = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  data-site-chrome="footer"
  hidden={hidden}
  class="border-t bg-background"
  transition:name="app-footer"
  transition:animate="none"
>
  <div
    class="flex w-full items-center justify-between gap-4 px-6 py-4 text-sm text-muted-foreground sm:px-8 lg:px-12"
  >
    <span class="flex items-center gap-2">
      <img
        src="/castor-logo.png"
        alt=""
        width="18"
        height="20"
        class="h-5 w-auto opacity-80"
      />
      Bebras Bolivia
    </span>
    <span>&copy; {year}</span>
  </div>
</footer>
