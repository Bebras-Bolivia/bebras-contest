{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.5",
  "description": "API con Express y TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun x --no-install wrangler dev --local --config ../wrangler.jsonc",
    "build": "tsc",
    "start": "bun run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prisma:generate": "prisma generate",
    "prisma:push": "bun x --no-install wrangler d1 migrations apply DB --local --config ../wrangler.jsonc",
    "db:seed": "tsx ./prisma/seed.ts --target local --config wrangler.jsonc",
    "db:tasks": "tsx ./prisma/seed-tasks.ts --target local --config wrangler.jsonc",
    "db:tasks:replace": "tsx ./prisma/replace-tasks.ts --target local --config wrangler.jsonc",
    "db:test-tasks": "tsx ./prisma/seed-test-tasks.ts --target local --config wrangler.jsonc",
    "catalog:migrate": "tsx ./prisma/migrate-catalog.ts",
    "catalog:validate": "tsx ./prisma/migrate-catalog.ts --check",
    "test:catalog": "tsx --test ./prisma/catalog-migration.test.ts ./prisma/task-catalog.test.ts ./prisma/replace-tasks.test.ts",
    "db:schools:fetch": "tsx ./scripts/fetch-schools.ts",
    "db:admins": "tsx ./scripts/seed-admins.ts --target local --config wrangler.jsonc",
    "db:clear-teams": "tsx ./scripts/clear-teams.ts --target local --config wrangler.jsonc"
  },
  "dependencies": {
    "@prisma/adapter-d1": "7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.13",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.5.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prisma": "^7.6.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2"
  }
}
