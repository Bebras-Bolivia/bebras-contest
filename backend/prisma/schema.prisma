generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "workerd"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              Int             @id @default(autoincrement())
  email           String          @unique
  firebaseUid     String?         @unique
  name            String?
  firstName       String?
  lastName        String?
  passwordHash    String          @default("")
  role            String          @default("admin")
  status          String          @default("approved")
  schoolCodUe     String?
  schoolName      String?
  institutionType String?
  phone           String?
  letterFilename  String?
  idFrontFilename String?
  idBackFilename  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  schools         TeacherSchool[]
  contests        Contest[]
}

model TeacherSchool {
  id             String   @id @default(cuid())
  userId         Int
  schoolCodUe    String?
  schoolName     String
  letterFilename String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model School {
  codUe     String  @id
  codLe     String?
  name      String
  dep       String
  pro       String
  sec       String
  dis       String
  depend    String?
  nivel     String?
  area      String?
  latitud   Float?
  longitud  Float?
  matricula Int?

  @@index([name])
  @@index([dep])
}

model TaskDraft {
  id                      String          @id @default(cuid())
  title                   String
  country                 String?
  year                    Int?
  sourceTaskCode          String?
  category                String
  difficulties            String
  bodyBlocks              String
  challengeBlocks         String
  answerType              String          @default("multiple_choice")
  answerConfig            String          @default("{}")
  answerKey               String          @default("{}")
  multipleChoiceOrderMode String          @default("fixed")
  answers                 String
  correctAnswerId         String
  shortAnswer             String          @default("")
  dragDropBackground      String          @default("null")
  dragDropItems           String          @default("[]")
  explanationBlocks       String          @default("[]")
  isPractice              Boolean         @default(false)
  // Sin ser de práctica pública, los maestros la pueden usar en sus prácticas.
  forTeachers             Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  contestTasks            ContestTask[]
  attemptAnswers          AttemptAnswer[]
}

model Contest {
  id                   String         @id @default(cuid())
  title                String
  // Lista JSON de categorías Bebras; cada una tiene sus propias preguntas.
  categories           String         @default("[]")
  durationMinutes      Int
  registrationStartsAt DateTime?
  registrationEndsAt   DateTime?
  startsAt             DateTime?
  endsAt               DateTime?
  scoring              String?
  questionDisplayMode  String         @default("one_by_one")
  allowPairs           Boolean        @default(false)
  shuffleOptions       Boolean        @default(false)
  showFeedback         Boolean        @default(false)
  showSolutions        Boolean        @default(false)
  showTotalScore       Boolean        @default(false)
  // Lo mismo, pero apenas el equipo entrega, sin esperar los resultados.
  showScoreOnSubmit     Boolean       @default(false)
  showFeedbackOnSubmit  Boolean       @default(false)
  showSolutionsOnSubmit Boolean       @default(false)
  publishedAt          DateTime?
  suspendedAt          DateTime?
  consolidatedAt       DateTime?
  resultsPublishedAt   DateTime?
  // Cuándo se publican solos los resultados; sin fecha, al cerrar la rendición.
  resultsAt            DateTime?
  resultsReleasedAt    DateTime?
  // Hasta cuándo sale con sus resultados en la portada; sin fecha, 7 días.
  resultsUntil         DateTime?
  // Una practica la crea un maestro para sus propios estudiantes: solo el la
  // ve y nunca sale en los listados publicos ni en los del administrador.
  isPractice           Boolean        @default(false)
  createdById          Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  createdBy            User?          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tasks                ContestTask[]
  groups               ContestGroup[]

  @@index([createdById])
}

model ContestTask {
  id            String    @id @default(cuid())
  contestId     String
  category      String    @default("")
  taskDraftId   String
  position      Int
  difficulty    String
  minScore      Int
  noAnswerScore Int
  maxScore      Int
  options       String    @default("{}")
  createdAt     DateTime  @default(now())
  contest       Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  taskDraft     TaskDraft @relation(fields: [taskDraftId], references: [id], onDelete: Restrict)

  @@unique([contestId, category, taskDraftId])
  @@unique([contestId, category, position])
  @@index([contestId, category, position])
}

model ContestGroup {
  id           String    @id @default(cuid())
  contestId    String
  createdById  Int?
  name         String
  // Categoría del grupo; sin ella (grupos anteriores) valen todas las del desafío.
  category     String?
  accessCode   String    @unique
  recoveryCode String
  firstUsedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  contest      Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  teams        Team[]

  @@index([contestId])
}

model Team {
  id                 String       @id @default(cuid())
  groupId            String
  participationMode  String       @default("individual")
  grade              String?
  memberOneFirstName String
  memberOneLastName  String
  memberTwoFirstName String?
  memberTwoLastName  String?
  personalCode       String       @unique
  sessionToken       String?      @unique
  sessionSeenAt      DateTime?
  status             String       @default("registered")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  group              ContestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attempt            Attempt?

  @@index([groupId])
}

model Attempt {
  id         String          @id @default(cuid())
  teamId     String          @unique
  startedAt  DateTime?
  endsAt     DateTime?
  finishedAt DateTime?
  status     String          @default("pending")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  answers    AttemptAnswer[]
  result     Result?
}

model AttemptAnswer {
  id              String    @id @default(cuid())
  attemptId       String
  taskDraftId     String
  responsePayload String
  isCorrect       Boolean?
  score           Int       @default(0)
  answeredAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  attempt         Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  taskDraft       TaskDraft @relation(fields: [taskDraftId], references: [id], onDelete: Restrict)

  @@unique([attemptId, taskDraftId])
  @@index([attemptId])
}

model Result {
  id            String    @id @default(cuid())
  attemptId     String    @unique
  totalScore    Int       @default(0)
  correctCount  Int       @default(0)
  answeredCount Int       @default(0)
  rankPosition  Int?
  calculatedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  attempt       Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
